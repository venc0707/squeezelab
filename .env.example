# Скопируй в .env (файл вне git) и заполни. Значения без кавычек и пробелов вокруг «=».
# Пустое значение = не задано.

# BingX. Для Phase 00 нужен ключ ТОЛЬКО НА ЧТЕНИЕ (без торговли и вывода).
BINGX_API_KEY=
BINGX_API_SECRET=
# vst = демо (open-api-vst.bingx.com), live = боевой (open-api.bingx.com)
BINGX_ENV=vst

# Telegram: токен от @BotFather и белый список chat_id через запятую
# (у групп chat_id отрицательный, например -1001234567890).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=

# Прокси только для Telegram (BingX всегда ходит напрямую). Схемы http и https, например
# локальный Xray: http://127.0.0.1:10809. Адрес может содержать логин и пароль: это секрет.
# Переменные HTTP_PROXY и HTTPS_PROXY процесса клиенты проекта игнорируют.
TELEGRAM_PROXY_URL=

# Каталог данных задаётся переменной окружения SQUEEZELAB_DATA_DIR (не из этого файла): на
# сервере её выставляет systemd-юнит, на ПК можно экспортировать в оболочке.
# Без неё берётся paths.data_dir из config/app.yaml.
